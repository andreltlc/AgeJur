rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }

    function isOwner(resource) {
      return request.auth != null && resource.data.userId == request.auth.uid;
    }

    function isShared(resource) {
      return request.auth != null
        && 'sharedWithUids' in resource.data
        && request.auth.uid in resource.data.sharedWithUids;
    }

    // Campos de compartilhamento só podem ser alterados pelo dono
    function sharingFieldsUnchanged() {
      return !('sharedWith' in request.resource.data.diff(resource.data).affectedKeys())
        && !('sharedWithUids' in request.resource.data.diff(resource.data).affectedKeys())
        && !('userId' in request.resource.data.diff(resource.data).affectedKeys())
        && !('ownerApelido' in request.resource.data.diff(resource.data).affectedKeys());
    }

    match /tokens/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /prazos/{id} {
      allow read: if isOwner(resource) || isShared(resource);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource)
        || (isShared(resource) && sharingFieldsUnchanged());
      allow delete: if isOwner(resource);
    }

    match /audiencias/{id} {
      allow read: if isOwner(resource) || isShared(resource);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource)
        || (isShared(resource) && sharingFieldsUnchanged());
      allow delete: if isOwner(resource);
    }

  }
}
